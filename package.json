{
  "name": "voicegis",
  "version": "2.0.0-beta.2",
  "description": "Voice-enabled spatial intelligence console with offline-first commands for Leaflet and OpenLayers",
  "main": "dist/voicegis.umd.cjs",
  "module": "dist/voicegis.es.js",
  "types": "dist/types/index.d.ts",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/types/index.d.ts",
      "import": "./dist/voicegis.es.js",
      "require": "./dist/voicegis.umd.cjs"
    },
    "./engines": "./src/engines/index.js",
    "./parser": "./src/parser/index.js",
    "./map": "./src/map/index.js",
    "./evaluation": "./src/evaluation/index.js"
  },
  "files": [
    "dist",
    "src",
    "LICENSE",
    "README.md"
  ],
  "scripts": {
    "dev": "vite",
    "build": "vite build && npm run build:types",
    "build:demo": "vite build --config vite.demo.config.js && node scripts/normalize-demo-build.js",
    "build:sites": "npm run build && npm run build:demo && node scripts/build-sites.js",
    "build:types": "tsc --project jsconfig.json",
    "preview": "vite preview",
    "test": "node --experimental-vm-modules ./node_modules/jest/bin/jest.js",
    "evaluate": "node scripts/evaluate.js",
    "lint": "eslint src/ demo/ scripts/ sites/"
  },
  "jest": {
    "testEnvironment": "node",
    "transform": {}
  },
  "keywords": [
    "voicegis",
    "voice",
    "gis",
    "leaflet",
    "openlayers",
    "speech",
    "whisper",
    "tensorflow",
    "maps",
    "wms",
    "geospatial",
    "offline",
    "pwa"
  ],
  "author": "blazing_helios",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/SanishKumar/VoiceGIS.git"
  },
  "bugs": {
    "url": "https://github.com/SanishKumar/VoiceGIS/issues"
  },
  "homepage": "https://voicemap-three.vercel.app/",
  "funding": {
    "type": "github",
    "url": "https://github.com/sponsors/SanishKumar"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "license": "MIT",
  "peerDependencies": {
    "leaflet": "^1.9.0",
    "ol": "^9.0.0"
  },
  "peerDependenciesMeta": {
    "leaflet": {
      "optional": true
    },
    "ol": {
      "optional": true
    }
  },
  "overrides": {
    "adm-zip": "0.6.0",
    "picomatch@^2.0.0": "2.3.2"
  },
  "dependencies": {
    "@huggingface/transformers": "^4.2.0",
    "@tensorflow-models/speech-commands": "^0.5.4",
    "@tensorflow/tfjs": "^4.17.0",
    "@tensorflow/tfjs-backend-webgl": "^4.17.0",
    "@vercel/analytics": "^2.0.1",
    "leaflet": "^1.9.0",
    "ol": "^9.0.0"
  },
  "devDependencies": {
    "@types/leaflet": "^1.9.21",
    "@types/ol": "^6.5.3",
    "eslint": "^8.57.0",
    "jest": "^29.7.0",
    "typescript": "^6.0.3",
    "vite": "^6.0.0"
  }
}
