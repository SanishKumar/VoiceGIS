{
  "name": "voicegis",
  "version": "2.2.1",
  "description": "Policy-aware natural-language GIS command compiler and execution toolkit",
  "main": "dist/voicegis.umd.cjs",
  "module": "dist/voicegis.es.js",
  "types": "dist/types/index.d.ts",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/types/index.d.ts",
      "import": "./dist/voicegis.es.js",
      "require": "./dist/voicegis.umd.cjs"
    },
    "./core": {
      "types": "./dist/types/core/index.d.ts",
      "import": "./dist/core/index.js",
      "require": "./dist/core/index.cjs"
    },
    "./adapters": {
      "types": "./dist/types/adapters/index.d.ts",
      "import": "./dist/adapters/index.js",
      "require": "./dist/adapters/index.cjs"
    },
    "./engines": {
      "types": "./dist/types/engines/index.d.ts",
      "import": "./dist/engines/index.js",
      "require": "./dist/engines/index.cjs"
    },
    "./parser": {
      "types": "./dist/types/parser/index.d.ts",
      "import": "./dist/parser/index.js",
      "require": "./dist/parser/index.cjs"
    },
    "./map": {
      "types": "./dist/types/map/index.d.ts",
      "import": "./dist/map/index.js",
      "require": "./dist/map/index.cjs"
    },
    "./evaluation": {
      "types": "./dist/types/evaluation/index.d.ts",
      "import": "./dist/evaluation/index.js",
      "require": "./dist/evaluation/index.cjs"
    },
    "./audio": {
      "types": "./dist/types/audio/index.d.ts",
      "import": "./dist/audio/index.js",
      "require": "./dist/audio/index.cjs"
    },
    "./package.json": "./package.json"
  },
  "sideEffects": false,
  "files": [
    "dist/*.js",
    "dist/*.cjs",
    "dist/adapters",
    "dist/audio",
    "dist/core",
    "dist/engines",
    "dist/evaluation",
    "dist/map",
    "dist/parser",
    "dist/types",
    "docs/adapters.md",
    "docs/api.md",
    "docs/core.md",
    "examples/package-command-core.js",
    "LICENSE",
    "README.md"
  ],
  "scripts": {
    "dev": "vite",
    "build": "vite build && vite build --config vite.subpaths.config.js && npm run build:types",
    "build:demo": "vite build --config vite.demo.config.js && node scripts/normalize-demo-build.js",
    "build:sites": "npm run build && npm run build:demo && node scripts/build-sites.js",
    "build:types": "tsc --project jsconfig.json",
    "preview": "vite preview",
    "test": "node --experimental-vm-modules ./node_modules/jest/bin/jest.js",
    "evaluate": "node scripts/evaluate.js",
    "lint": "eslint src/ demo/ scripts/ sites/ e2e/",
    "validate:package": "node scripts/validate-package.js",
    "prepublishOnly": "npm test -- --runInBand && npm run lint && npm run build && npm run validate:package",
    "test:e2e": "playwright test",
    "test:all": "npm test -- --runInBand && npm run test:e2e",
    "test:live-ogc": "node --experimental-vm-modules ./node_modules/jest/bin/jest.js adapterOgcLive"
  },
  "jest": {
    "testEnvironment": "node",
    "transform": {},
    "testPathIgnorePatterns": [
      "/node_modules/",
      "/e2e/",
      "/dist/",
      "/dist-demo/"
    ]
  },
  "keywords": [
    "voicegis",
    "voice",
    "gis",
    "leaflet",
    "openlayers",
    "speech",
    "whisper",
    "tensorflow",
    "maps",
    "wms",
    "geospatial",
    "natural-language",
    "command-compiler",
    "spatial-query",
    "policy",
    "offline",
    "pwa"
  ],
  "author": "blazing_helios",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/SanishKumar/VoiceGIS.git"
  },
  "bugs": {
    "url": "https://github.com/SanishKumar/VoiceGIS/issues"
  },
  "homepage": "https://voicemap-three.vercel.app/",
  "funding": {
    "type": "github",
    "url": "https://github.com/sponsors/SanishKumar"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "license": "MIT",
  "peerDependencies": {
    "@huggingface/transformers": "^4.2.0",
    "@tensorflow-models/speech-commands": "^0.5.4",
    "@tensorflow/tfjs": "^4.17.0",
    "leaflet": "^1.9.0",
    "ol": "^9.0.0"
  },
  "peerDependenciesMeta": {
    "@huggingface/transformers": {
      "optional": true
    },
    "@tensorflow-models/speech-commands": {
      "optional": true
    },
    "@tensorflow/tfjs": {
      "optional": true
    },
    "leaflet": {
      "optional": true
    },
    "ol": {
      "optional": true
    }
  },
  "overrides": {
    "adm-zip": "0.6.0",
    "picomatch@^2.0.0": "2.3.2"
  },
  "devDependencies": {
    "@huggingface/transformers": "^4.2.0",
    "@playwright/test": "^1.62.1",
    "@tensorflow-models/speech-commands": "^0.5.4",
    "@tensorflow/tfjs": "^4.17.0",
    "@tensorflow/tfjs-backend-webgl": "^4.17.0",
    "@types/leaflet": "^1.9.21",
    "@types/ol": "^6.5.3",
    "@vercel/analytics": "^2.0.1",
    "eslint": "^8.57.0",
    "jest": "^29.7.0",
    "leaflet": "^1.9.0",
    "ol": "^9.0.0",
    "typescript": "^6.0.3",
    "vite": "^6.0.0"
  }
}
